* text=auto eol=lf

*.pbxproj text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.lock text eol=lf

# Windows batch files (gradlew.bat) end lines with CRLF; that is not
# trailing whitespace for `git diff --check`.
*.bat whitespace=cr-at-eol

*.xcuserstate binary
