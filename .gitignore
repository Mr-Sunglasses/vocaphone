# The one exception: a speech fixture the on-device engine test transcribes.
!android/app/src/androidTest/assets/*.wav
.env
.env.*
!.env.example
*.log
*.p12
*.mobileprovision

# direnv: the repository-root .envrc is checked in and contains no secrets.
# Every other .envrc is personal — gateway/.envrc in particular is easy to
# create by copying gateway/.env, which carries a live bearer token.
.direnv/
.envrc
.envrc.local
!/.envrc

# Android (see also android/.gitignore)
.gradle/
android/local.properties
android/.idea/
android/captures/
android/*.hprof

# Local Netlify folder
.netlify
