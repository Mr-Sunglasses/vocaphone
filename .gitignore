.DS_Store
.cursor/
.idea/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.build/
.swiftpm/
DerivedData/
/ios/build/
*.xcresult
*.xcarchive
*.ipa
*.xcuserstate
xcuserdata/
gateway/.venv/
gateway/.pytest_cache/
gateway/.ruff_cache/
gateway/.mypy_cache/
gateway/.omo/
gateway/data/
gateway/*.db
gateway/*.sqlite
gateway/*.sqlite3
